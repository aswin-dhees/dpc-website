---
---

<section id="home" class="relative min-h-screen flex items-center pt-20 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-gradient-to-br from-cream-light via-cream to-cream-dark/40"></div>
  <div class="absolute top-20 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent-warm/10 rounded-full blur-3xl"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 rounded-full mb-6">
          <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
          <span class="text-sm font-medium text-primary">Now Delivering in Chennai</span>
        </div>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-text-dark leading-[1.15] text-balance max-w-2xl mx-auto lg:mx-0">
          Fresh, Nutritious
          <span class="text-primary block mt-1">Pet Food</span>
          <span class="block mt-3 text-2xl sm:text-3xl lg:text-4xl text-text-medium">Delivered to Your Door in Chennai</span>
        </h1>
        
        <p class="mt-6 text-lg sm:text-xl text-text-medium leading-relaxed max-w-xl mx-auto lg:mx-0 text-pretty">
          We help you become a nurturing pet parent with fresh, balanced meals made from real ingredients. Because your furry family deserves the very best.
        </p>
        
        <!-- Stats -->
        <div class="flex flex-wrap justify-center lg:justify-start gap-8 mt-8 py-6 border-y border-cream-dark/30">
          <div class="text-center lg:text-left">
            <span class="block text-3xl font-bold text-primary">1000+</span>
            <span class="text-sm text-text-light font-medium">Meals Served</span>
          </div>
          <div class="text-center lg:text-left">
            <span class="block text-3xl font-bold text-primary">100%</span>
            <span class="text-sm text-text-light font-medium">Fresh Ingredients</span>
          </div>
          <div class="text-center lg:text-left">
            <span class="block text-3xl font-bold text-primary">5★</span>
            <span class="text-sm text-text-light font-medium">Pet Parent Reviews</span>
          </div>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mt-8 justify-center lg:justify-start">
          <a
            href="https://wa.me/message/VCJ4UCGX3BA7G1"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-cream-light bg-primary hover:bg-primary-dark rounded-full transition-all duration-300 shadow-xl shadow-primary/30 hover:shadow-primary/50 hover:scale-105"
          >
            <span>Order Now</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="https://api.whatsapp.com/send?phone=919363611809&text=Hi%2c%20I%27m%20interested%20in%20ordering%20free%20samples"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-primary bg-cream-light hover:bg-white border-2 border-primary/20 hover:border-primary/40 rounded-full transition-all duration-300"
          >
            <span>Get Free Samples</span>
          </a>
        </div>
        
      </div>
      
      <!-- Hero Image -->
      <div class="relative">
        <div class="relative z-10">
          <!-- Main Image Container -->
          <div class="relative bg-gradient-to-br from-cream-light to-cream rounded-3xl p-6 shadow-2xl shadow-cream-darker/50">
            <div class="aspect-square rounded-2xl bg-gradient-to-br from-primary/10 to-accent-warm/20 flex items-center justify-center overflow-hidden">
              <img
                src="/images/hero-pet-fresh-food.jpg"
                alt="Happy dog and cat enjoying fresh Dhee's Pet Company food"
                class="w-full h-full object-cover rounded-2xl"
                loading="eager"
              />
            </div>
            
            <!-- Floating Badge -->
            <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl p-4 shadow-xl">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </div>
                <div>
                  <span class="block text-sm font-semibold text-text-dark">Vet Approved</span>
                  <span class="text-xs text-text-light">Balanced Nutrition</span>
                </div>
              </div>
            </div>
            
            <!-- Floating Badge Right -->
            <div class="absolute -top-4 -right-4 bg-white rounded-2xl p-4 shadow-xl">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13h14a2 2 0 012 2v1H3v-1a2 2 0 012-2z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 13a4 4 0 118 0M12 7V5"></path>
                  </svg>
                </div>
                <div>
                  <span class="block text-sm font-semibold text-text-dark">Freshly Cooked</span>
                  <span class="text-xs text-text-light">Made to Order</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Decorative Elements -->
        <div class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-br from-primary/5 to-accent-warm/10 rounded-full blur-2xl"></div>
      </div>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce hidden lg:block">
    <a href="#features" class="flex flex-col items-center gap-2 text-text-light hover:text-primary transition-colors">
      <span class="text-xs font-medium">Scroll to explore</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </div>
</section>
