---
const testimonials = [
  {
    name: "Amudhu",
    pet: "Vikram (Rottweiler)",
    location: "Porur, Chennai",
    image: "/images/testimonial-1.jpg",
    rating: 5,
    text: "From the first order to the weekly deliveries, Dhees has always been punctual and professional. The food is well-portioned, and the detailed nutrition info makes me feel like I am making the right choice for Vikram.",
  },
  {
    name: "Velazhagan",
    pet: "Kay (Beagle)",
    location: "Keelkattalai, Chennai",
    image: "/images/testimonial-2.jpg",
    rating: 5,
    text: "Dhees has completely transformed how I feed Kay, my dog. Knowing the meals are nutritionist-formulated and preservative-free gives me peace of mind. Plus, I have noticed improved energy and a shinier coat in Kay.",
  },
];
---

<section id="testimonials" class="py-20 lg:py-28 bg-gradient-to-b from-cream-light to-cream relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-accent-warm/10 rounded-full blur-3xl"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-primary/10 text-primary text-sm font-semibold rounded-full mb-4">
        Happy Pet Parents
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-text-dark text-balance">
        What Chennai&apos;s Pet Parents
        <span class="text-primary block mt-2">Are Saying</span>
      </h2>
      <p class="mt-6 text-lg text-text-medium leading-relaxed text-pretty">
        Join hundreds of pet parents who&apos;ve made the switch to fresh, nutritious meals for their furry family members.
      </p>
    </div>
    
    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {testimonials.map((testimonial, index) => (
        <div class="group bg-white rounded-3xl p-8 shadow-lg shadow-cream-darker/20 hover:shadow-xl hover:shadow-cream-darker/30 transition-all duration-300">
          <!-- Quote Icon -->
          <div class="w-12 h-12 bg-primary/10 rounded-2xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
            </svg>
          </div>
          
          <!-- Rating -->
          <div class="flex gap-1 mb-4">
            {Array.from({ length: testimonial.rating }).map((_, i) => (
              <svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
            ))}
          </div>
          
          <!-- Testimonial Text -->
          <p class="text-text-medium leading-relaxed mb-6 text-pretty">
            {`"${testimonial.text}"`}
          </p>
          
          <!-- Author -->
          <div class="flex items-center gap-4 pt-6 border-t border-cream-dark/30">
            <div
              class="w-14 h-14 rounded-2xl bg-gradient-to-br from-primary/15 to-accent-warm/20 text-primary font-bold text-xl flex items-center justify-center"
              aria-label={`${testimonial.name} profile initial`}
            >
              {testimonial.name.charAt(0).toUpperCase()}
            </div>
            <div>
              <span class="block font-semibold text-text-dark">{testimonial.name}</span>
              <span class="block text-sm text-primary font-medium">{testimonial.pet}</span>
              <span class="block text-xs text-text-light">{testimonial.location}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Trust Stats -->
    <div class="mt-16 grid sm:grid-cols-3 gap-6">
      <div class="bg-white rounded-2xl p-6 text-center shadow-lg shadow-cream-darker/10">
        <span class="block text-4xl font-bold text-primary">1000+</span>
        <span class="text-text-medium">Meals Delivered</span>
      </div>
      <div class="bg-white rounded-2xl p-6 text-center shadow-lg shadow-cream-darker/10">
        <span class="block text-4xl font-bold text-primary">500+</span>
        <span class="text-text-medium">Happy Pets</span>
      </div>
      <div class="bg-white rounded-2xl p-6 text-center shadow-lg shadow-cream-darker/10">
        <span class="block text-4xl font-bold text-primary">4.9★</span>
        <span class="text-text-medium">Average Rating</span>
      </div>
    </div>
  </div>
</section>
