---

<section id="features" class="py-20 lg:py-28 bg-cream-light relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent-warm/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-primary/10 text-primary text-sm font-semibold rounded-full mb-4">
        Why Choose Fresh?
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-text-dark text-balance">
        The Truth About Fresh Food
        <span class="text-primary block mt-2">That Nobody Tells You</span>
      </h2>
    </div>
    
    <!-- Features Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <div 
          class="group relative bg-white rounded-3xl p-8 shadow-lg shadow-cream-darker/20 hover:shadow-xl hover:shadow-cream-darker/30 transition-all duration-300 hover:-translate-y-1"
        >
          <!-- Icon -->
          <div class="w-14 h-14 bg-gradient-to-br from-primary to-primary-light rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-primary/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconPaths[feature.icon]}></path>
            </svg>
          </div>

          <!-- Content -->
          <h3 class="text-xl font-semibold text-text-dark mb-3 group-hover:text-primary transition-colors capitalize">
            {feature.title}
          </h3>
          <p class="text-text-medium leading-relaxed text-pretty">
            {feature.description}
          </p>
          
          <!-- Decorative Corner -->
          <div class="absolute top-4 right-4 w-8 h-8 border-t-2 border-r-2 border-primary/10 rounded-tr-xl group-hover:border-primary/30 transition-colors"></div>
        </div>
      ))}
    </div>
    
    <!-- Bottom Copy -->
    <div class="mt-16 text-center">
      <p class="text-text-medium max-w-4xl mx-auto leading-relaxed text-pretty">
        Your pet deserves more than just shelf-stable kibble. Fresh, real food nourishes your pet the way nature intended-with better ingredients, better digestion, and better health outcomes.
      </p>
    </div>
  </div>
</section>
