---
const features = [
  {
    icon: "leaf",
    title: "100% Fresh Ingredients",
    description: "We use only human-grade, locally sourced ingredients. No fillers, no preservatives, no mystery meats — just real food your pet can thrive on.",
  },
  {
    icon: "heart",
    title: "Vet-Formulated Recipes",
    description: "Every recipe is crafted with veterinary nutritionists to ensure complete and balanced meals that support your pet's health at every life stage.",
  },
  {
    icon: "truck",
    title: "Doorstep Delivery",
    description: "Fresh meals delivered right to your door in Chennai. Convenient subscription plans or one-time orders — you choose what works for you.",
  },
  {
    icon: "shield",
    title: "No Harmful Additives",
    description: "Unlike commercial kibble filled with cheap fillers like corn and soy, our meals contain zero artificial colors, flavors, or preservatives.",
  },
  {
    icon: "scale",
    title: "Portioned for Your Pet",
    description: "Meals are pre-portioned based on your pet's weight, age, and activity level. No guesswork — just the right amount every time.",
  },
  {
    icon: "sparkle",
    title: "Visible Health Benefits",
    description: "Pet parents report shinier coats, better digestion, increased energy, and healthier weight within weeks of switching to fresh food.",
  },
];

const iconPaths: Record<string, string> = {
  leaf: "M12 2a10 10 0 0 1 7.38 16.75 10 10 0 0 1-14.76 0A10 10 0 0 1 12 2m0 4a1 1 0 0 0-1 1v4.59l-2.29-2.3a1 1 0 0 0-1.42 1.42l4 4a1 1 0 0 0 1.42 0l4-4a1 1 0 0 0-1.42-1.42L14 11.59V7a1 1 0 0 0-1-1",
  heart: "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z",
  truck: "M1 3h15v13H1zm15 6h4l3 3v4h-7zm-5 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm9 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z",
  scale: "M16 16v-4a4 4 0 0 0-8 0v4M6 12h12M9 16h6M12 4v4",
  sparkle: "M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z",
};
---

<section id="features" class="py-20 lg:py-28 bg-cream-light relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-accent-warm/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-primary/10 text-primary text-sm font-semibold rounded-full mb-4">
        Why Choose Fresh?
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-text-dark text-balance">
        The Truth About Pet Food
        <span class="text-primary block mt-2">That Nobody Tells You</span>
      </h2>
      <p class="mt-6 text-lg text-text-medium leading-relaxed text-pretty">
        Research shows that being overweight shortens your dog&apos;s life by 2.5 years. Many popular kibble brands use cheap fillers that offer little nutritional value. We&apos;re here to change that.
      </p>
    </div>
    
    <!-- Features Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <div 
          class="group relative bg-white rounded-3xl p-8 shadow-lg shadow-cream-darker/20 hover:shadow-xl hover:shadow-cream-darker/30 transition-all duration-300 hover:-translate-y-1"
        >
          <!-- Icon -->
          <div class="w-14 h-14 bg-gradient-to-br from-primary to-primary-light rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg shadow-primary/25">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconPaths[feature.icon]}></path>
            </svg>
          </div>
          
          <!-- Content -->
          <h3 class="text-xl font-semibold text-text-dark mb-3 group-hover:text-primary transition-colors">
            {feature.title}
          </h3>
          <p class="text-text-medium leading-relaxed text-pretty">
            {feature.description}
          </p>
          
          <!-- Decorative Corner -->
          <div class="absolute top-4 right-4 w-8 h-8 border-t-2 border-r-2 border-primary/10 rounded-tr-xl group-hover:border-primary/30 transition-colors"></div>
        </div>
      ))}
    </div>
    
    <!-- Bottom CTA -->
    <div class="mt-16 text-center">
      <p class="text-text-medium mb-6">
        Ready to give your pet the nutrition they deserve?
      </p>
      <a
        href="#products"
        class="inline-flex items-center gap-2 px-8 py-4 text-base font-semibold text-cream-light bg-primary hover:bg-primary-dark rounded-full transition-all duration-300 shadow-xl shadow-primary/30 hover:shadow-primary/50 hover:scale-105"
      >
        <span>Explore Our Menu</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
