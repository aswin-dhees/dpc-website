---

<section id="products" class="py-20 lg:py-28 bg-cream relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-1/2 right-0 w-72 h-72 bg-accent-warm/10 rounded-full blur-3xl translate-x-1/2"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-primary/10 text-primary text-sm font-semibold rounded-full mb-4">
        Our Recipes
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-text-dark text-balance">
        Handcrafted in small batches
      </h2>
      <p class="mt-6 text-lg text-text-medium leading-relaxed text-pretty">
        Human-grade • No artificial preservatives • Lab-tested
      </p>
    </div>
    
    <!-- Pet Type Filter -->
    <div class="flex justify-center gap-4 mb-12" data-filter-controls>
      <button
        class="px-6 py-3 bg-primary text-cream-light font-semibold rounded-full shadow-lg shadow-primary/25 transition-all cursor-pointer"
        data-filter="all"
        type="button"
      >
        All Pets
      </button>
      <button
        class="px-6 py-3 bg-white text-text-medium font-semibold rounded-full border border-cream-dark transition-all cursor-pointer"
        data-filter="dogs"
        type="button"
      >
        🐕 Dogs
      </button>
      <button
        class="px-6 py-3 bg-white text-text-medium font-semibold rounded-full border border-cream-dark transition-all cursor-pointer"
        data-filter="cats"
        type="button"
      >
        🐈 Cats
      </button>
    </div>
    
    <!-- Products Grid -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8" data-products-grid>
      {products.map((product) => (
        <div
          class="group bg-white rounded-3xl overflow-hidden shadow-lg shadow-cream-darker/20 hover:shadow-xl hover:shadow-cream-darker/30 transition-all duration-300 hover:-translate-y-1"
          data-pet={product.pet.toLowerCase()}
        >
          <!-- Image -->
          <div class="relative aspect-[16/9] bg-gradient-to-br from-cream-light to-cream overflow-hidden">
            <img
              src={product.image}
              alt={`${product.name} — fresh ${product.pet.toLowerCase()} meal from Dhee's Pet Company, Chennai`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute top-4 left-4 px-3 py-1 bg-white/90 backdrop-blur-sm text-text-dark text-xs font-medium rounded-full">
              {product.pet}
            </div>
          </div>
          
          <!-- Content -->
          <div class="p-5">
            <h3 class="text-lg font-semibold text-text-dark mb-2 group-hover:text-primary transition-colors">
              {product.name}
            </h3>
            <p class="text-sm text-text-medium leading-relaxed mb-3 line-clamp-2">
              {product.description}
            </p>
            
            <!-- Highlights -->
            <ul class="space-y-1.5 mb-3">
              {product.highlights.map((item) => (
                <li class="text-xs text-text-medium leading-snug line-clamp-1">
                  {item}
                </li>
              ))}
            </ul>
            
            <!-- Price & Order -->
            <div class="flex items-center justify-between pt-4 border-t border-cream-dark/30">
              <div>
                <span class="text-xl font-bold text-primary">{product.price}</span>
                <span class="text-xs text-text-light ml-1">{product.unit}</span>
              </div>
              <a
                href={product.orderLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-primary/10 hover:bg-primary text-primary hover:text-white text-sm font-semibold rounded-xl transition-all duration-300"
              >
                <span>Order Now</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </a>
            </div>

            <!-- Nutrition -->
            <div class="grid grid-cols-4 gap-2 mt-3 pt-3 border-t border-cream-dark/30">
              <div class="text-center">
                <p class="text-sm font-bold text-text-dark">{product.nutrition.kcal}</p>
                <p class="text-[10px] uppercase tracking-wide text-text-light">kcal</p>
              </div>
              <div class="text-center">
                <p class="text-sm font-bold text-text-dark">{product.nutrition.protein}</p>
                <p class="text-[10px] uppercase tracking-wide text-text-light">protein</p>
              </div>
              <div class="text-center">
                <p class="text-sm font-bold text-text-dark">{product.nutrition.fat}</p>
                <p class="text-[10px] uppercase tracking-wide text-text-light">fat</p>
              </div>
              <div class="text-center">
                <p class="text-sm font-bold text-text-dark">{product.nutrition.carbs}</p>
                <p class="text-[10px] uppercase tracking-wide text-text-light">carbs</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
  </div>
</section>

<script is:inline>
  const controls = document.querySelector("[data-filter-controls]");
  const buttons = controls ? Array.from(controls.querySelectorAll("button[data-filter]")) : [];
  const cards = Array.from(document.querySelectorAll("[data-products-grid] [data-pet]"));

  function setActiveButton(activeFilter) {
    buttons.forEach((button) => {
      const isActive = button.dataset.filter === activeFilter;
      button.classList.toggle("bg-primary", isActive);
      button.classList.toggle("text-cream-light", isActive);
      button.classList.toggle("shadow-lg", isActive);
      button.classList.toggle("shadow-primary/25", isActive);

      button.classList.toggle("bg-white", !isActive);
      button.classList.toggle("text-text-medium", !isActive);
      button.classList.toggle("border", !isActive);
      button.classList.toggle("border-cream-dark", !isActive);
      button.classList.toggle("hover:border-primary/30", !isActive);
      button.classList.toggle("hover:text-primary", !isActive);
      button.classList.toggle("hover:text-cream-light", isActive);
    });
  }

  function applyFilter(filter) {
    cards.forEach((card) => {
      const pet = card.dataset.pet;
      const show = filter === "all" || pet === filter;
      card.classList.toggle("hidden", !show);
    });
    setActiveButton(filter);
  }

  if (buttons.length && cards.length) {
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        applyFilter(button.dataset.filter || "all");
      });
    });
    applyFilter("all");
  }
</script>
