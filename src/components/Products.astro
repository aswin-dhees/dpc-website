---
const products = [
  {
    name: "Chicken & Rice Bowl",
    pet: "Dogs",
    description: "Tender chicken breast with brown rice, carrots, and spinach. A complete, balanced meal for everyday nutrition.",
    price: "₹199",
    unit: "per meal",
    image: "/images/chicken-rice.jpg",
    tags: ["High Protein", "Grain-Inclusive"],
    popular: true,
  },
  {
    name: "Fish Feast",
    pet: "Cats",
    description: "Wild-caught fish with essential omega-3s, pumpkin, and a touch of coconut oil for a glossy coat.",
    price: "₹249",
    unit: "per meal",
    image: "/images/fish-feast.jpg",
    tags: ["Omega Rich", "Grain-Free"],
    popular: false,
  },
  {
    name: "Lamb & Veggie Mix",
    pet: "Dogs",
    description: "Premium lamb with sweet potato, green beans, and blueberries. Perfect for dogs with chicken sensitivities.",
    price: "₹279",
    unit: "per meal",
    image: "/images/lamb-veggie.jpg",
    tags: ["Novel Protein", "Sensitive Stomach"],
    popular: false,
  },
  {
    name: "Turkey Delight",
    pet: "Cats",
    description: "Lean turkey with chicken liver, cranberries, and essential taurine for heart and eye health.",
    price: "₹229",
    unit: "per meal",
    image: "/images/turkey-delight.jpg",
    tags: ["Lean Protein", "Heart Healthy"],
    popular: true,
  },
];
---

<section id="products" class="py-20 lg:py-28 bg-cream relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute top-1/2 right-0 w-72 h-72 bg-accent-warm/10 rounded-full blur-3xl translate-x-1/2"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-4 py-2 bg-primary/10 text-primary text-sm font-semibold rounded-full mb-4">
        Our Menu
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-text-dark text-balance">
        Fresh Meals Made with
        <span class="text-primary">Love & Science</span>
      </h2>
      <p class="mt-6 text-lg text-text-medium leading-relaxed text-pretty">
        Every recipe is crafted by pet nutritionists and made fresh in small batches. Real ingredients you can see and pronounce.
      </p>
    </div>
    
    <!-- Pet Type Filter -->
    <div class="flex justify-center gap-4 mb-12">
      <button class="px-6 py-3 bg-primary text-cream-light font-semibold rounded-full shadow-lg shadow-primary/25 transition-all">
        All Pets
      </button>
      <button class="px-6 py-3 bg-white text-text-medium font-semibold rounded-full border border-cream-dark hover:border-primary/30 hover:text-primary transition-all">
        🐕 Dogs
      </button>
      <button class="px-6 py-3 bg-white text-text-medium font-semibold rounded-full border border-cream-dark hover:border-primary/30 hover:text-primary transition-all">
        🐈 Cats
      </button>
    </div>
    
    <!-- Products Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {products.map((product) => (
        <div class="group bg-white rounded-3xl overflow-hidden shadow-lg shadow-cream-darker/20 hover:shadow-xl hover:shadow-cream-darker/30 transition-all duration-300 hover:-translate-y-1">
          <!-- Image -->
          <div class="relative aspect-square bg-gradient-to-br from-cream-light to-cream overflow-hidden">
            <img
              src={product.image}
              alt={`${product.name} — fresh ${product.pet.toLowerCase()} meal from Dhee's Pet Company, Chennai`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {product.popular && (
              <div class="absolute top-4 left-4 px-3 py-1 bg-primary text-white text-xs font-semibold rounded-full">
                Popular
              </div>
            )}
            <div class="absolute top-4 right-4 px-3 py-1 bg-white/90 backdrop-blur-sm text-text-dark text-xs font-medium rounded-full">
              {product.pet}
            </div>
          </div>
          
          <!-- Content -->
          <div class="p-6">
            <h3 class="text-lg font-semibold text-text-dark mb-2 group-hover:text-primary transition-colors">
              {product.name}
            </h3>
            <p class="text-sm text-text-medium leading-relaxed mb-4 line-clamp-2">
              {product.description}
            </p>
            
            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-4">
              {product.tags.map((tag) => (
                <span class="px-2 py-1 bg-cream text-text-light text-xs font-medium rounded-lg">
                  {tag}
                </span>
              ))}
            </div>
            
            <!-- Price & CTA -->
            <div class="flex items-center justify-between pt-4 border-t border-cream-dark/30">
              <div>
                <span class="text-xl font-bold text-primary">{product.price}</span>
                <span class="text-xs text-text-light ml-1">{product.unit}</span>
              </div>
              <button class="w-10 h-10 bg-primary/10 hover:bg-primary text-primary hover:text-white rounded-xl flex items-center justify-center transition-all duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- View All CTA -->
    <div class="mt-12 text-center">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 px-8 py-4 text-base font-semibold text-primary bg-white hover:bg-cream-light border-2 border-primary/20 hover:border-primary/40 rounded-full transition-all duration-300"
      >
        <span>View Full Menu</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
